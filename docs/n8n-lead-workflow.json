{
  "name": "MoldScience — Profit App lead",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "moldscience-app-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Website form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 300],
      "webhookId": "moldscience-app-lead",
      "notes": "Copy the PRODUCTION url from this node into Vercel as LEAD_WEBHOOK_URL."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-email",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "operator": { "type": "string", "operation": "regex" }
            },
            {
              "id": "has-name",
              "leftValue": "={{ $json.body.name }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate",
      "name": "Valid lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-140, 300],
      "notes": "Second line of defence. The site already runs a honeypot, a timing check and the not-a-robot box."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-ROLLDOG-API-ENDPOINT",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ firstName: $json.body.name.split(' ')[0], lastName: $json.body.name.split(' ').slice(1).join(' '), email: $json.body.email, phone: $json.body.phone, leadSource: 'Website — Profit Building App' }) }}",
        "options": {}
      },
      "id": "rolldog",
      "name": "Create Rolldog lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 200],
      "notes": "PLACEHOLDER. Ask Rolldog support for the create-lead endpoint and auth header, then fill in the URL and add an HTTP Header Auth credential. Field names below are a guess — map them to Rolldog's actual schema.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Website form').item.json.body.email }}",
        "subject": "Your free MoldScience Profit Building App",
        "emailType": "html",
        "message": "=<h2>Thanks, {{ $('Website form').item.json.body.name }}!</h2>\n<p>Here is your free Profit Building App from Mold Science Technologies.</p>\n<p><strong>Install it on your phone:</strong></p>\n<ul>\n  <li><a href=\"REPLACE_WITH_IOS_APP_LINK\">iPhone (App Store)</a></li>\n  <li><a href=\"REPLACE_WITH_ANDROID_APP_LINK\">Android (Google Play)</a></li>\n</ul>\n<p>Questions? Call us at (888) 770-3130 or reply to this email.</p>\n<p style=\"color:#666;font-size:12px\">You are receiving this because you requested the app at moldsciencetechnologies.com. We do not share your details with anyone.</p>",
        "options": {}
      },
      "id": "send-app",
      "name": "Email the app to prospect",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [140, 380],
      "notes": "Swap for the SMTP node if not using Gmail. Replace the two app links.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "gkochuk@moldsciencetechnologies.com",
        "subject": "=Profit Calculator lead — {{ $('Website form').item.json.body.name }}",
        "emailType": "html",
        "message": "=<h2>New Profit Building App request</h2>\n<p><strong>Name:</strong> {{ $('Website form').item.json.body.name }}</p>\n<p><strong>Email:</strong> {{ $('Website form').item.json.body.email }}</p>\n<p><strong>Cell:</strong> {{ $('Website form').item.json.body.phone }}</p>\n<p>Please text the app link to this contractor and follow up.</p>",
        "options": {}
      },
      "id": "notify",
      "name": "Notify Greg",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [360, 380],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [580, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ JSON.stringify({ error: 'Invalid lead' }) }}",
        "options": {}
      },
      "id": "respond-bad",
      "name": "400 Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [140, 560]
    }
  ],
  "connections": {
    "Website form": { "main": [[{ "node": "Valid lead?", "type": "main", "index": 0 }]] },
    "Valid lead?": {
      "main": [
        [
          { "node": "Create Rolldog lead", "type": "main", "index": 0 },
          { "node": "Email the app to prospect", "type": "main", "index": 0 }
        ],
        [{ "node": "400 Invalid", "type": "main", "index": 0 }]
      ]
    },
    "Email the app to prospect": { "main": [[{ "node": "Notify Greg", "type": "main", "index": 0 }]] },
    "Notify Greg": { "main": [[{ "node": "200 OK", "type": "main", "index": 0 }]] },
    "Create Rolldog lead": { "main": [[]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
